        { "id": "e1000000-0000-4000-8000-000000000011", "role": "user", "ts": "2026-10-12T12:00:00.000Z", "text": "What did we decide about the small form factor case and graphics card clearance?" },
        { "id": "e1000000-0000-4000-8000-000000000012", "role": "assistant", "ts": "2026-10-12T12:00:14.000Z", "text": "Measure GPU length and leave clearance for its power connector in the small form factor case." },
        { "id": "e1000000-0000-4000-8000-000000000013", "role": "user", "ts": "2026-10-15T10:00:00.000Z", "text": "I run Kitty's server on Node 24 and use SQLite as canonical storage." },
