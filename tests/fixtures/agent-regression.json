        { "id": "e2000000-0000-4000-8000-000000000005", "role": "user", "ts": "2026-10-24T08:00:00.000Z", "text": "For that migration, how should indexing recover after Qdrant is down?" },
        { "id": "e2000000-0000-4000-8000-000000000006", "role": "assistant", "ts": "2026-10-24T08:00:15.000Z", "text": "Persist pending index work in SQLite and retry idempotently using turn IDs." },
        { "id": "e2000000-0000-4000-8000-000000000007", "role": "user", "ts": "2026-10-26T13:30:00.000Z", "text": "Earlier you said MiniLM vectors are 768 dimensions, but that was wrong; the local model is 384 dimensions." },
